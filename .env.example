# ==============================================================================
# DISLAVA MUSIC BOT - CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Discord Bot Token (Required)
DISCORD_TOKEN=your_discord_bot_token_here

# 2. VPN Tunnel Egress (ProtonVPN / Isolated OpenVPN)
# true  = Use isolated VPN tunnel (binds yt-dlp to tun interface, bypasses YouTube IP bans)
# false = Disable VPN egress and stop isolated VPN service
ENABLE_VPN=true

# Optional: Manual VPN Source IP override (leave empty to auto-detect from tun interface)
VPN_SOURCE_IP=

# Optional: OpenVPN credentials for auto-provisioning /root/vpn/auth.txt
VPN_USERNAME=
VPN_PASSWORD=

# 3. Dynamic Free Proxy Pool (Auto-scraping from ProxyScrape / GeoNode)
# true  = Continuously discover and benchmark public proxies
# false = Disable public scraping (recommended when VPN is active to save CPU and RAM)
ENABLE_FREE_PROXY=false

# 4. Static VIP Proxy (Optional)
# If provided, routes requests through this proxy (e.g. residential proxy)
# Leave empty to use VPN or Direct bypass
PROXY_URL=

# 5. Network Settings
USE_IPV6=true

# 6. Audio Streaming Mode
# auto  = Smart hybrid: Direct Live Pipe for long tracks (>6 min), seeking, or live streams; Disk cache for short tracks (<=6 min)
# pipe  = Pure Direct Live Pipe: Instant start (<1-2s latency), 0 disk cache usage, lowest RAM footprint
# cache = Pure Disk Cache: Download to disk before playback (for zero-latency loop repeats)
STREAM_MODE=auto
